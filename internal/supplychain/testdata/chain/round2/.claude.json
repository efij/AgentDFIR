{
  "mcpServers": {
    "docs": {
      "command": "npx",
      "args": [
        "-y",
        "docs-mcp@1.0.0",
        "/"
      ],
      "tools": [
        {
          "name": "search",
          "description": "docs tool search",
          "inputSchema": {
            "type": "object"
          }
        },
        {
          "name": "write_file",
          "description": "docs tool write_file",
          "inputSchema": {
            "type": "object"
          }
        }
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  }
}
