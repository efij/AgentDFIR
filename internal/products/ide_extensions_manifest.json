        "${PROFILE_ROOT}/.positron/extensions/*/extension.cjs",
        "${PROFILE_ROOT}/.positron/extensions/*/dist/extension.cjs"
      ],
      "category": "product_state",
      "sensitivity": "low"
    }
  ]
}
