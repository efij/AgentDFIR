# Evidence must survive a checkout byte for byte.
#
# internal/compat/testdata holds a real .adfir package produced by a
# released binary, and the test asserts its SHA256SUMS still verifies. Git's
# end-of-line conversion would rewrite the JSON and JSONL inside it on a
# Windows checkout and break every hash — which is exactly what it did.
# Nothing under here is text as far as git is concerned.
internal/compat/testdata/** -text -diff

# Conformance fixtures for the .adfir format: sealed bytes, same rule.
testdata/conformance/** -text -diff

# Golden outputs compared byte for byte with what the code prints (LF).
internal/chain/testdata/*.golden.json text eol=lf
internal/corpus/testdata/*.golden text eol=lf
docs/atlas-coverage.md text eol=lf

# Corpus inputs are evidence too: their hashes and byte offsets appear in
# golden outputs, so a Windows checkout must not convert line endings.
internal/corpus/testdata/** -text -diff
